# Host path mounted by docker-compose (used by Compose, not inside the container).
PIPELINE_HOST_ROOT=./data
# PDF inbox may be a separate existing tree; nested folders are mirrored downstream.
PDF_INPUT_HOST_DIR=./data/01-pdf-input
# Optimized TeX, field registry and audit report may use a separate host tree.
OPTIMIZED_TEX_HOST_DIR=./data/03-review-pending

# Existing Lexoid image used as the base of the combined cron worker image.
LEXOID_IMAGE=lexoid:local
# Optional APT acceleration. Use the exact Debian and debian-security base URLs
# supplied by your mirror provider; leave empty to use Debian's official mirrors.
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=

# All paths below are inside the container and persist under /data.
PIPELINE_ROOT=/data
PDF_INPUT_DIR=/input
LEXOID_TEX_DIR=/data/02-lexoid-tex
OPTIMIZED_TEX_DIR=/optimized
REVIEWED_TEX_DIR=/data/04-reviewed-tex
JSON_OUTPUT_DIR=/data/05-json-output
# Keep disabled until human review/JSON production is ready.
ENABLE_JSON_STAGE=false
PIPELINE_STATE_DB=/data/state/pipeline.sqlite3
PIPELINE_LOG_FILE=/data/logs/pipeline.jsonl

POLL_INTERVAL_SECONDS=5
FILE_STABLE_SECONDS=10
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=1800
# 0 = unlimited retries. A changed file has a new fingerprint and a fresh job.
MAX_ATTEMPTS=3

# The combined pipeline image inherits the Lexoid executable from LEXOID_IMAGE.
# Placeholders are expanded as argv tokens; no shell is used.
LEXOID_COMMAND=lexoid latex -i {input} -o {output} --model {model} --start-page {start_page}
LEXOID_MODEL=gpt-5.6
LEXOID_TIMEOUT_SECONDS=7200

OPTIMIZER_COMMAND=texopt
# LLM only generates semantic aliases; original VALUE_ID and values remain unchanged.
# Keep the cache below /data so disposable cron containers share stable names.
TEXOPT_MODEL=gpt-5.6-sol
OPTIMIZER_EXTRA_ARGS=--llm-model gpt-5.6-sol --name-cache /data/state/texopt-names.json --llm-syntax-repair --syntax-repair-cache /data/state/texopt-syntax-repairs.json --syntax-repair-batch-pages 5 --llm-repair-on-failure
OPTIMIZER_TIMEOUT_SECONDS=3600

# Model credentials passed into Lexoid/optimizer inside the container.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://47.85.193.244
# CODEX_MODEL_PROVIDER=lexiod_openai
# CODEX_MODEL=gpt-5.6-terra
# CODEX_NETWORK_ACCESS=true
